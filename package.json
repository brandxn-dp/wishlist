{
  "name": "wishlist",
  "version": "1.0.0",
  "description": "A self-hosted, iOS-style shopping wishlist PWA. Paste a product link, get a tidy card with photo, price, brand and store.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "puppeteer-core": "^25.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  }
}
